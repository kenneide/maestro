{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run client",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/client/server.mjs",
      "cwd": "${workspaceFolder}/client",
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "serverReadyAction": {
        "pattern": "Maestro is ready: (http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Run website",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "start"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "serverReadyAction": {
        "pattern": "Maestro site: (http://localhost:[0-9]+/)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Run client — Wi-Fi",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/client/server.mjs",
      "cwd": "${workspaceFolder}/client",
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "serverReadyAction": {
        "pattern": "Maestro is ready: (http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "env": {
        "OSC_HOST": "0.0.0.0",
        "DJAY_HOST": ""
      }
    },
    {
      "name": "Run client — iPhone/iPad",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/client/server.mjs",
      "cwd": "${workspaceFolder}/client",
      "console": "internalConsole",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "serverReadyAction": {
        "pattern": "Maestro is ready: (http://localhost:[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "env": {
        "OSC_HOST": "0.0.0.0",
        "HTTP_HOST": "0.0.0.0",
        "DJAY_HOST": ""
      }
    },
    {
      "name": "Run plugin (standalone)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/plugin/build/MaestroCue_artefacts/Debug/Standalone/Maestro Cue.app/Contents/MacOS/Maestro Cue",
      "cwd": "${workspaceFolder}/plugin",
      "preLaunchTask": "Build plugin standalone (Debug)"
    },
    {
      "name": "Package plugin for sharing",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "${workspaceFolder}/plugin/scripts/package.sh",
        "--reveal"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
